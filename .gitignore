*.xls

# IDE & System files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent skills cache
.agents/
skills-lock.json
.claude/

# Private user documentation & PDFs (kept strictly local)
Documentation/
*.pdf

# Local notes that reference accounts or environments. Never committed:
# git history is permanent, so a credential pushed once must be rotated.
*.local.md

# Generated SECRET_KEY for local runs. Never committed.
.secret.local

# Knowledge graph tool output
graphify-out/

# Local testing tools, launchers & CI artifacts
Launch_*.bat
datalink_*.py
ci_check.db
.kilo/

# Scratch benchmark and profile scripts
scratch/

# Test caches and coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS and temporary files
desktop.ini
*.tmp
*.temp
*.bak
*.swp
*~

# Screen recordings and device capture
*.mp4
scrcpy*

# Ingestion progress and transient logs
ingestion_manifest*.json
ingestion_progress*.json

# Anonymised test fixtures are test code, not data. The *.xlsx rule above
# exists to keep source registers out of the repo; these two carry no real
# name, phone or email (see tests/test_park_gate_acceptance.py) and the
# acceptance test would silently skip in CI without them.
!tests/fixtures/park_gate_noor_raw.xlsx
!tests/fixtures/park_gate_noor_unique.xlsx

