# Environment variables
.env
.env.*
!.env.example
frontend/.env
frontend/.env.local
frontend/.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Database & Storage
*.db
*.sqlite3
prototype_core.db
uploads/
logs/
*.log
*.dump
*.dump.tmp
backups/

# Node dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Data sheets & heavy files
Builders data/
Excel sheets/
Dubai Hills/
Dubai Hills Raw Work/
Dubai Hills*/
*.xlsx
